# ── Anthropic — powers the demo agent (server-side only) ─────────────────────
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5)
AGENT_MODEL=

# ── BranderUX connection (client-side, inlined at build) ─────────────────────
# The SDK targets the BranderUX production origin; the beta key + project id
# come from your BranderUX project (this repo's scripts/seed-brander-project.mts
# provisions one).
NEXT_PUBLIC_BRANDER_TOKEN=bux_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_BRANDER_PROJECT_ID=

# ── Public origin of THIS site ───────────────────────────────────────────────
# Used for absolute product-image URLs in the agent prompt and for SEO
# (canonical/OG/sitemap). Leave SITE_URL empty locally to derive per-request.
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# ── Rate limiting (optional, recommended for public deploys) ─────────────────
# Without these, the agent endpoint is unlimited (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global LLM-query budget per day (canned home is never counted). Default 1500.
AGENT_DAILY_LIMIT=

# ── Seeding (scripts/seed-brander-project.mts) ───────────────────────────────
# Long-lived refresh token of your BranderUX account (preferred), or a raw
# BRANDER_COOKIE='auth_token=…'. Point BRANDER_API_BASE at your environment.
BRANDER_REFRESH_TOKEN=
BRANDER_API_BASE=
