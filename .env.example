# Atelier Nova, local wiring.
# The agent is not in this repo: the BranderUX project hosts it, so there is no
# model key and no agent endpoint here.

# The BranderUX project id (Projects, Settings)
NEXT_PUBLIC_BRANDER_PROJECT_ID=c67f2ad9-6977-4589-b372-dea3aa3a3da2

# A publishable project key (Projects, API Keys). Add this app's origin,
# http://localhost:3001 locally, to the key's allowed origins or it is refused.
NEXT_PUBLIC_BRANDER_API_KEY=bux_pk_REPLACE_ME

# Public origin of this site (canonical URLs, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://nova.branderux.app

# Seeding only (npm run seed / npm run seed:agent)
BRANDER_REFRESH_TOKEN=
BRANDER_API_BASE=https://api.branderux.com/api/v1
SITE_URL=https://nova.branderux.app
# PROJECT_ID=            # optional: seed into an existing project instead of the by-name lookup
